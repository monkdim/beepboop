<!--
  Built with the official Dalamud SDK, and shipping exactly one assembly.

  This used to be a plain Microsoft.NET.Sdk project with hand-written <Reference> elements
  pointing at the Dalamud dev libraries, packaged by DalamudPackager 2.1.13 - a packager
  from the Dalamud 10 era. That packager had already been caught stamping the wrong API
  level into the manifest, and it also writes loader fields (LoadSync, CanUnloadAsync,
  LoadRequiredState) that nothing here ever asked for. The SDK writes the manifest the
  running Dalamud expects, and keeps the reference set correct by itself.

  The rotation engine's sources are compiled straight in rather than referenced as a second
  assembly, so the plugin is a single DLL with no deps.json for the loader to resolve
  against. OneTwoPunch.Core remains a real project so the tests can build and run it
  without Dalamud or the game present - both compile the same files.
-->
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.0.48.0</Version>
    <Authors>monkdim</Authors>
    <Company>-</Company>
    <Description>Collapses each supported job into a single-target button and an AoE button.</Description>
    <PackageProjectUrl>https://github.com/monkdim/beepboop</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>OneTwoPunch</AssemblyName>
    <RootNamespace>OneTwoPunch.Plugin</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>true</ImplicitUsings>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../OneTwoPunch.Core/**/*.cs"
             Exclude="../OneTwoPunch.Core/bin/**/*.cs;../OneTwoPunch.Core/obj/**/*.cs" />
  </ItemGroup>

</Project>
